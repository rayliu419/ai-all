 y="452" width="740" height="40" as="geometry"/></mxCell><mxCell id="t142" value="左侧栏每一项都是一个插件；关掉插件，它的入口和后台任务一起消失。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5a7a6a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="一键跳对话"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="590" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t143" value="一键 = 从卡片跳进一条新会话，上下文和 skill 都已挂好，并落一条运行记录" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1a3a24;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1060" height="28" as="geometry"/></mxCell><mxCell id="n144" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbf9;strokeColor=#d7e6dc;strokeWidth=1;arcSize=5;" vertex="1" parent="1"><mxGeometry x="50" y="80" width="450" height="364" as="geometry"/></mxCell><mxCell id="t145" value="① 你在看面板" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5a7a6a;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="66" y="90" width="320" height="18" as="geometry"/></mxCell><mxCell id="n146" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdfefd;strokeColor=#c3dbcc;strokeWidth=1.1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="410" height="96" as="geometry"/></mxCell><mxCell id="t147" value="✗  CI · 2 项没过" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#7b2118;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="86" y="130" width="380" height="18" as="geometry"/></mxCell><mxCell id="t148" value="gh pr checks · 15:43 · 旧数据 ⟳" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#6b8577;fontFamily