<mxfile host="app.diagrams.net" modified="2026-11-13T00:00:00.000Z" agent="pi" version="24.7.17"><diagram id="v1" name="六步骨架"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="先定六个形状，再让 AI 填内容：越靠前越便宜，越往后越贵" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#1a3a24;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="20" width="1010" height="26" as="geometry"/></mxCell><mxCell id="e2" value="改形状的成本：低  →  高" style="edgeStyle=none;rounded=0;html=1;strokeColor=#d97706;strokeWidth=1.8;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#f5faf6;fontSize=10;fontColor=#5a7a6a;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="64" as="sourcePoint"/><mxPoint x="1030" y="64" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n3" value="① mockup&lt;br&gt;界面与交互" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5ec;strokeColor=#2a8f4f;strokeWidth=1.6;fontSize=13;fontColor=#1a3a24;fontFamily=Helvetica;arcSize=10;" vertex="1" parent="1"><mxGeometry x="45" y="96" width="152" height="66" as="geometry"/></mxCell><mxCell id="t4" value="mockup.html" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6b8577;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="45" y="172" width="152" height="20" as="geometry"/></mxCell><mxCell id="n5" value="② DB 设计&lt;br&gt;实体 · 关系 · 时间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5ec;strokeColor=#2a8f4f;strokeWidth=1.6;fontSize=13;fontColor=#1a3a24;fontFamily=Helvetica;arcSize=10;" vertex="1" parent="1"><mxGeometry x="217" y="96" width="152" height="66" as="geometry"/></mxCell><mxCell id="t6" value="schema.sql" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6b8577;fontF