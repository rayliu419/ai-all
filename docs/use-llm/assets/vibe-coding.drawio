e="edgeStyle=none;rounded=0;html=1;strokeColor=#a9c9b5;strokeWidth=1.3;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#f5faf6;fontSize=10;fontColor=#5a7a6a;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="541" y="129" as="sourcePoint"/><mxPoint x="561" y="129" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n14" value="⑤ 目录结构&lt;br&gt;模块边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5ec;strokeColor=#2a8f4f;strokeWidth=1.6;fontSize=13;fontColor=#1a3a24;fontFamily=Helvetica;arcSize=10;" vertex="1" parent="1"><mxGeometry x="733" y="96" width="152" height="66" as="geometry"/></mxCell><mxCell id="t15" value="tree" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6b8577;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="733" y="172" width="152" height="20" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a9c9b5;strokeWidth=1.3;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#f5faf6;fontSize=10;fontColor=#5a7a6a;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="713" y="129" as="sourcePoint"/><mxPoint x="733" y="129" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n17" value="⑥ 系统层次&lt;br&gt;依赖方向" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5ec;strokeColor=#2a8f4f;strokeWidth=1.6;fontSize=13;fontColor=#1a3a24;fontFamily=Helvetica;arcSize=10;" vertex="1" parent="1"><mxGeometry x="905" y="96" width="152" height="66" as="geometry"/></mxCell><mxCell id="t18" value="layers.md" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6b8577;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="905" y="172" width="152" height="20" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#a9c9b5;strokeWidth=1.3;endArrow=block;endFill=1;endSize=6;labelBackgroundColor=#f5faf6;fontSize=10;fontColor=#5a7a6a;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885" y="129" as="sourcePoint"/><mxPoint x="905" y="129" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n20" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbf9;strokeColor=#d7e6dc;strokeWidth=1;arcSize=5;" vertex="1" parent="1"><mxGeometry x="45" y="220" width="1010" height="84" as="geometry"/></mxCell><mxCell id="t21" value="每一步的产出物都是可 diff 的文件（不是「对话里说清楚了」）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1a3a24;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="62" y="228" width="980" height="22" as="geometry"/></mxCell><mxCell id="t22" value="AI 之后必须 conform 到这些文件；形状一旦落盘，实现就不会跑偏。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2d3a31;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="62" y="252" width="980" height="20" as="geometry"/></mxCell><mxCell id="t23" value="越靠前的步骤越该多迭代：mockup 改十次很便宜，schema 改十次要迁数据。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2d3a31;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="62" y="274" width="980" height="20" as="geometry"/></mxCell><mxCell id="n24" value="反模式：先写码再补 mockup ·  让 AI 一次出整套设计（无法逐个 review） ·  形状只活在对话里 ·  命名与目录交给 AI 自由发挥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e6;strokeColor=#e6d5b8;strokeWidth=1;fontSize=11;fontColor=#7c5200;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1"><mxGeometry x="45" y="320" width="1010" height="52" as="geometry"/></mxCell><mxCell id="t25" value="这六步对应六个「可评审的中间产物」，而不是六次提问。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5a7a6a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="45" y="386" width="1010" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>